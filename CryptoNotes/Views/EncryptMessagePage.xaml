<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CryptoNotes.Views.EncryptMessagePage" Title="/ENCRYPT">
    <ContentPage.Content>
        <RefreshView IsRefreshing="{Binding IsRefreshing}" RefreshColor="#33ff33"
             Command="{Binding RefreshViewCommand}">
            <ScrollView BackgroundColor="#0a0a0a" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <StackLayout Spacing="10" Padding="15">

                    <Label TextColor="#33ff33" FontFamily="{StaticResource ConsoleCode}" FontSize="16"
                        Text="*** PGP message encryption:" />
                    <BoxView HeightRequest="1" BackgroundColor="#1a8c1a" />

                    <Label TextColor="#ffb000" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                        Text="SIGN MESSAGE:" />
                    <Switch x:Name="SignedF" OnColor="#1a8c1a" ThumbColor="#33ff33" IsToggled="False" Toggled="OnToggled" />

                    <Picker x:Name="privatePicker"
                        Title="Select Private Key" IsVisible="false"
                        TitleColor="#1a8c1a" TextColor="#33ff33" BackgroundColor="#111111" />

                    <Label x:Name="PwdLbl" IsVisible="false" TextColor="#ffb000"
                        FontFamily="{StaticResource ConsoleCode}" FontSize="14" Text="PASSPHRASE:" />
                    <Entry x:Name="PwdTxt" TextColor="#33ff33" FontFamily="{StaticResource ConsoleCode}"
                        FontSize="16" BackgroundColor="#111111" PlaceholderColor="#1a8c1a"
                        Keyboard="Plain" IsPassword="true" Placeholder="********" IsVisible="false" />

                    <Label TextColor="#ffb000" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                        Text="RECIPIENT KEY:" />
                    <Picker x:Name="publicPicker"
                        Title="Select Public Key"
                        TitleColor="#1a8c1a" TextColor="#33ff33" BackgroundColor="#111111" />

                    <Label TextColor="#ffb000" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                        Text="PLAINTEXT:" />
                    <Editor x:Name="MessageTxt" TextColor="#33ff33" FontFamily="{StaticResource ConsoleCode}"
                        Placeholder="/msg ..." PlaceholderColor="#1a8c1a"
                        FontSize="14" BackgroundColor="#111111" HeightRequest="150"
                        Keyboard="Chat" />

                    <Button Margin="0,10,0,0" Text="/ENCRYPT"
                        x:Name="encryptBtn"
                        FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                        BackgroundColor="#111111" TextColor="#33ff33"
                        BorderColor="#1a8c1a" BorderWidth="1"
                        Clicked="EncryptMessageClicked" />

                </StackLayout>
            </ScrollView>
        </RefreshView>
    </ContentPage.Content>
</ContentPage>
