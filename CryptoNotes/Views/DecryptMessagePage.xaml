<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CryptoNotes.Views.DecryptMessagePage" Title="/DECRYPT">
    <ContentPage.Content>
        <ScrollView BackgroundColor="#0a0a0a" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <StackLayout Spacing="10" Padding="15">

                <Label TextColor="#33ff33" FontFamily="{StaticResource ConsoleCode}" FontSize="16"
                    Text="*** PGP message decryption:" />
                <BoxView HeightRequest="1" BackgroundColor="#1a8c1a" />

                <Label TextColor="#ffb000" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                    Text="PRIVATE KEY:" />
                <Picker x:Name="privatePicker"
                    Title="Select Private Key"
                    TitleColor="#1a8c1a" TextColor="#33ff33" BackgroundColor="#111111" />

                <Label x:Name="PwdLbl" TextColor="#ffb000" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                    Text="PASSPHRASE:" />
                <Entry x:Name="PwdTxt" TextColor="#33ff33" FontFamily="{StaticResource ConsoleCode}"
                    FontSize="16" BackgroundColor="#111111" PlaceholderColor="#1a8c1a"
                    Keyboard="Plain" IsPassword="true" Placeholder="********" />

                <Label TextColor="#ffb000" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                    Text="CIPHERTEXT:" />
                <Editor x:Name="MessageTxt" TextColor="#ff3333" FontFamily="{StaticResource ConsoleCode}"
                    Placeholder="Paste PGP message..." PlaceholderColor="#1a8c1a"
                    FontSize="14" BackgroundColor="#111111" HeightRequest="150"
                    Keyboard="Chat" />

                <Button Margin="0,10,0,0" Text="/DECRYPT"
                    x:Name="decryptBtn"
                    FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                    BackgroundColor="#111111" TextColor="#33ff33"
                    BorderColor="#1a8c1a" BorderWidth="1"
                    Clicked="DecryptMessageClicked" />

            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
