<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CryptoNotes.Views.ConversationsPage" Title="#channels">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="/join" Clicked="NewConversationClicked" />
        <ToolbarItem Text="/refresh" Clicked="RefreshClicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <StackLayout BackgroundColor="#0a0a0a" Spacing="0">

            <!-- Not logged in warning -->
            <Frame x:Name="NotLoggedInFrame" BackgroundColor="#111111" CornerRadius="0"
                Padding="12" Margin="0" IsVisible="false" BorderColor="#ff3333">
                <Label TextColor="#ff3333" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                    Text="*** ERROR: Not connected to server. Use /NICK to register or login." />
            </Frame>

            <!-- Search / New conversation -->
            <Frame x:Name="SearchFrame" BackgroundColor="#111111" CornerRadius="0"
                Padding="10" Margin="0" IsVisible="false" BorderColor="#1a8c1a">
                <StackLayout Spacing="8">
                    <Label TextColor="#ffb000" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                        Text="/WHOIS - Find a user:" />
                    <Entry x:Name="SearchEntry" TextColor="#33ff33" FontFamily="{StaticResource ConsoleCode}"
                        FontSize="18" BackgroundColor="#0a0a0a" PlaceholderColor="#1a8c1a"
                        Placeholder="username" />
                    <Button Text="/SEARCH" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                        BackgroundColor="#111111" TextColor="#33ff33"
                        BorderColor="#1a8c1a" BorderWidth="1"
                        Clicked="SearchUsersClicked" />

                    <CollectionView x:Name="SearchResults" BackgroundColor="Transparent"
                        SelectionMode="Single" SelectionChanged="SearchResultSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout Padding="8,4">
                                    <Label TextColor="#00e5ff"
                                        FontFamily="{StaticResource ConsoleCode}" FontSize="16">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="  " />
                                                <Span Text="{Binding Username}" />
                                                <Span Text=" [+pgp]" ForegroundColor="#1a8c1a" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Channel header -->
            <StackLayout BackgroundColor="#111111" Padding="12,8">
                <Label TextColor="#33ff33" FontFamily="{StaticResource ConsoleCode}" FontSize="16"
                    Text="*** Active channels:" />
            </StackLayout>
            <BoxView HeightRequest="1" BackgroundColor="#1a8c1a" />

            <!-- Conversations list - styled like IRC channel list -->
            <RefreshView x:Name="ConversationRefresh" IsRefreshing="{Binding IsRefreshing}"
                RefreshColor="#33ff33" Command="{Binding RefreshCommand}">
                <CollectionView x:Name="ConversationsList" BackgroundColor="#0a0a0a"
                    SelectionMode="Single" SelectionChanged="ConversationSelected">
                    <CollectionView.EmptyView>
                        <StackLayout Padding="15">
                            <Label TextColor="#1a8c1a" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                                Text="*** No channels. Use /join to start a conversation." />
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Padding="12,8" BackgroundColor="#0a0a0a">
                                <Label FontFamily="{StaticResource ConsoleCode}" FontSize="16">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="#" ForegroundColor="#1a8c1a" />
                                            <Span Text="{Binding Username}" ForegroundColor="#ffb000" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label TextColor="#555555" FontFamily="{StaticResource ConsoleCode}" FontSize="13"
                                    Text="{Binding LastMessagePreview}"
                                    LineBreakMode="TailTruncation" MaxLines="1" />
                                <BoxView HeightRequest="1" BackgroundColor="#1a1a1a" Margin="0,4,0,0" />
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
