<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CryptoNotes.Views.ConversationsPage" Title="Messages">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New" Clicked="NewConversationClicked" />
        <ToolbarItem Text="Refresh" Clicked="RefreshClicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <StackLayout BackgroundColor="Black">

            <!-- Not logged in warning -->
            <Frame x:Name="NotLoggedInFrame" BackgroundColor="#141d2b" CornerRadius="5"
                Padding="15" Margin="15" IsVisible="false">
                <StackLayout Spacing="10">
                    <Label TextColor="#ff4444" FontFamily="{StaticResource ConsoleCode}" FontSize="18"
                        Text="Not connected to a server. Go to Account to register or log in." />
                </StackLayout>
            </Frame>

            <!-- Search / New conversation -->
            <Frame x:Name="SearchFrame" BackgroundColor="#141d2b" CornerRadius="5"
                Padding="10" Margin="15,15,15,0" IsVisible="false">
                <StackLayout Spacing="10">
                    <Label TextColor="#9f00ff" FontFamily="{StaticResource ConsoleCode}" FontSize="18"
                        Text="Find a user to message:" />
                    <Entry x:Name="SearchEntry" TextColor="#ffaf00" FontFamily="{StaticResource ConsoleCode}"
                        FontSize="20" BackgroundColor="Black" PlaceholderColor="LightGray"
                        Placeholder="Search username..." />
                    <Button Text="Search" BackgroundColor="#007fdf" TextColor="White"
                        Clicked="SearchUsersClicked" />

                    <CollectionView x:Name="SearchResults" BackgroundColor="Transparent"
                        SelectionMode="Single" SelectionChanged="SearchResultSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout Padding="10,5">
                                    <Label Text="{Binding Username}" TextColor="#0086ff"
                                        FontFamily="{StaticResource ConsoleCode}" FontSize="22" />
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Conversations list -->
            <Label Text="&#xf0e0;" FontFamily="FontAwesomeSolid" FontSize="35" TextColor="#9f00ff"
                Margin="15,15,0,0" />
            <Label TextColor="#9f00ff" FontFamily="{StaticResource ConsoleCode}" Text="Conversations"
                FontSize="35" Margin="15,0,0,0" />

            <RefreshView x:Name="ConversationRefresh" IsRefreshing="{Binding IsRefreshing}"
                RefreshColor="Blue" Command="{Binding RefreshCommand}">
                <CollectionView x:Name="ConversationsList" BackgroundColor="Black"
                    SelectionMode="Single" SelectionChanged="ConversationSelected">
                    <CollectionView.EmptyView>
                        <StackLayout Padding="15">
                            <Label TextColor="#0086ff" FontFamily="{StaticResource ConsoleCode}" FontSize="18"
                                Text="No conversations yet. Tap 'New' to start messaging." />
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Padding="15,10" BackgroundColor="Black">
                                <StackLayout Orientation="Horizontal">
                                    <Label Text="&#xf007;" FontFamily="FontAwesomeSolid" FontSize="22"
                                        TextColor="#0086ff" VerticalOptions="Center" />
                                    <Label Text="{Binding Username}" TextColor="#ffaf00"
                                        FontFamily="{StaticResource ConsoleCode}" FontSize="25"
                                        VerticalOptions="Center" Margin="10,0,0,0" />
                                </StackLayout>
                                <Label Text="{Binding LastMessagePreview}" TextColor="#0086ff"
                                    FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                                    LineBreakMode="TailTruncation" MaxLines="1" />
                                <BoxView HeightRequest="1" BackgroundColor="#141d2b" Margin="0,5,0,0" />
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
