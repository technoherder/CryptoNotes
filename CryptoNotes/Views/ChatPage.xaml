<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CryptoNotes.Views.ChatPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="/refresh" Clicked="RefreshClicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid BackgroundColor="#0a0a0a" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Channel topic bar -->
            <StackLayout Grid.Row="0" BackgroundColor="#111111" Padding="10,6">
                <Label TextColor="#1a8c1a" FontFamily="{StaticResource ConsoleCode}" FontSize="12"
                    Text="*** Channel is PGP encrypted | msgs never leave device unencrypted" />
            </StackLayout>

            <!-- IRC-style message log -->
            <CollectionView x:Name="MessagesView" Grid.Row="1" BackgroundColor="#0a0a0a"
                Margin="6,2,6,2">
                <CollectionView.EmptyView>
                    <StackLayout Padding="15" VerticalOptions="CenterAndExpand">
                        <Label TextColor="#1a8c1a" FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                            HorizontalTextAlignment="Center"
                            Text="*** Now talking in #encrypted&#10;*** Topic is: End-to-end encrypted conversation&#10;*** Set by CryptoNotes on connect&#10;&#10;*** Waiting for messages..." />
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- IRC-style: [HH:MM] <nick> message -->
                        <StackLayout Padding="2,1" Orientation="Horizontal" Spacing="0">
                            <Label Text="{Binding TimeStamp}" TextColor="#555555"
                                FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                                VerticalOptions="Start" />
                            <Label Text=" " FontSize="14" />
                            <Label Text="{Binding SenderLabel}" TextColor="{Binding SenderColor}"
                                FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                                VerticalOptions="Start" />
                            <Label Text=" " FontSize="14" />
                            <Label Text="{Binding PlainText}" TextColor="#cccccc"
                                FontFamily="{StaticResource ConsoleCode}" FontSize="14"
                                VerticalOptions="Start" LineBreakMode="WordWrap"
                                HorizontalOptions="FillAndExpand" />
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- IRC-style input bar -->
            <Grid Grid.Row="2" BackgroundColor="#111111" Padding="8,4" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" TextColor="#33ff33" FontFamily="{StaticResource ConsoleCode}"
                    FontSize="16" Text=">" VerticalOptions="Center" />

                <Editor x:Name="MessageInput" Grid.Column="1" TextColor="#33ff33"
                    FontFamily="{StaticResource ConsoleCode}" FontSize="15"
                    BackgroundColor="#0a0a0a" Placeholder="/msg ..."
                    PlaceholderColor="#1a8c1a" HeightRequest="40"
                    Keyboard="Chat" AutoSize="TextChanges" />

                <Button x:Name="SendBtn" Grid.Column="2" Text="/SEND"
                    FontFamily="{StaticResource ConsoleCode}" FontSize="13"
                    BackgroundColor="#111111" TextColor="#33ff33"
                    BorderColor="#1a8c1a" BorderWidth="1"
                    HeightRequest="40" Padding="8,0"
                    Clicked="SendMessageClicked" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
