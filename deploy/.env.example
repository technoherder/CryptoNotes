# =============================================================================
# CryptoNotes Production Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Your domain name (required)
DOMAIN=talk.technoherder.com

# HTTPS port (default: 443, use 1337 or any other port if needed)
HTTPS_PORT=443

# Generate with: openssl rand -base64 48
TOKEN_SIGNING_KEY=CHANGE_ME_GENERATE_A_SECURE_KEY

# Optional settings (defaults shown)
TOKEN_EXPIRY_HOURS=24
MAX_LOGIN_ATTEMPTS=5
MAX_MESSAGE_SIZE=65536
MIN_PASSWORD_LENGTH=8
MESSAGE_EXPIRY_DAYS=30

# Admin dashboard IP allowlist (comma-separated, supports CIDR)
# Leave empty to only allow localhost
ADMIN_ALLOWED_IPS=
