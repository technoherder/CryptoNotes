# =============================================================================
# CryptoNotes Docker Environment
# Copy this file to .env and set your values:
#   cp .env.example .env
# =============================================================================

# REQUIRED: Token signing key (generate with: openssl rand -base64 48)
TOKEN_SIGNING_KEY=CHANGE-ME-GENERATE-WITH-openssl-rand-base64-48

# Optional: Token expiry in hours (default: 24)
TOKEN_EXPIRY_HOURS=24

# Optional: Max login attempts per minute per IP (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Optional: Max message size in bytes (default: 65536 = 64KB)
MAX_MESSAGE_SIZE=65536

# Optional: Minimum password length (default: 8)
MIN_PASSWORD_LENGTH=8

# Optional: Auto-delete messages older than N days (default: 30)
MESSAGE_EXPIRY_DAYS=30
